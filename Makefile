RUST_MANIFEST := protocol/rust/Cargo.toml
RUST_STATICLIB := protocol/rust/target/release/libqset_can_protocol.a
RUST_SOURCES := $(wildcard protocol/rust/src/*.rs)
CC ?= cc
CFLAGS ?= -std=c11 -Wall -Wextra -Werror -pedantic -O2

# Firmware targets select their node at build time: make node-config NODE=<name>
# where <name> is one of NODES below (e.g. NODE=ADCS). 
# Names must match the QSET_CAN_NODE_* values in protocol/include/qset_can.h.
NODES := OBC ADCS COMMS PAYLOAD BATT MPPT
NODE_CONFIG := build/node/$(NODE)/qset_node_config.h

.PHONY: all test rust-test rust-check-no-std c-test node-config clean

all: $(RUST_STATICLIB)

$(RUST_STATICLIB): $(RUST_SOURCES) protocol/rust/Cargo.toml
	cargo build --release --manifest-path $(RUST_MANIFEST)

build/test_c_api: protocol/tests/test_c_api.c protocol/include/qset_can.h $(RUST_STATICLIB)
	mkdir -p build
	$(CC) $(CFLAGS) -Iprotocol/include protocol/tests/test_c_api.c $(RUST_STATICLIB) -o $@

node-config: $(NODE_CONFIG)

# Generated per node so all six configurations can exist side by side.
$(NODE_CONFIG): Makefile
	mkdir -p $(@D)
	printf '%s\n' \
	  '/* Generated by make NODE=$(NODE). Do not edit. */' \
	  '#ifndef QSET_NODE_CONFIG_H' \
	  '#define QSET_NODE_CONFIG_H' \
	  '' \
	  '#include "qset_can.h"' \
	  '' \
	  '#define QSET_LOCAL_NODE_NAME "$(NODE)"' \
	  '#define QSET_LOCAL_NODE_ID QSET_CAN_NODE_$(NODE)' \
	  '' \
	  '#endif' > $@

rust-test:
	cargo test --manifest-path $(RUST_MANIFEST)

rust-check-no-std:
	cargo check --manifest-path $(RUST_MANIFEST) --no-default-features

c-test: build/test_c_api
	./build/test_c_api

test: rust-test rust-check-no-std c-test

clean:
	cargo clean --manifest-path $(RUST_MANIFEST)
	rm -rf build
